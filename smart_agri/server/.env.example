# ==================== 环境配置 ====================
# 运行环境：dev（开发）或 prod（生产）
ENV=dev

# ==================== 数据库配置 ====================
# PostgreSQL 连接 URL（生产环境必填）
# 格式：postgresql+asyncpg://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/agri_ai

# ==================== Redis 配置 ====================
# Redis 连接 URL
REDIS_URL=redis://localhost:6379/0

# 挂起会话超时时间（秒），默认 30 分钟
PENDING_SESSION_TIMEOUT=1800

# ==================== 向量数据库配置 ====================
# ChromaDB 持久化目录
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ChromaDB 集合名称
CHROMA_COLLECTION_NAME=farm_experience_rules

# ==================== LLM 服务配置 ====================
# AnythingLLM API URL
ANYTHING_LLM_API_URL=http://localhost:3001/api/v1

# AnythingLLM API Key（生产环境必填）
# 请替换为您的实际 API Key
ANYTHING_LLM_API_KEY=your-api-key-here

# ==================== Bucketing 配置 ====================
# 温度桶大小（°C），默认 2°C 一档
TEMP_BUCKET_SIZE=2

# 湿度桶大小（%），默认 10% 一档
HUMIDITY_BUCKET_SIZE=10

# 光照强度桶大小（lux），默认 500 lux 一档
LIGHT_BUCKET_SIZE=500

# 土壤湿度桶大小（%），默认 10% 一档
SOIL_MOISTURE_BUCKET_SIZE=10

# ==================== 时间窗口配置 ====================
# 操作聚合窗口（分钟），默认 20 分钟
ACTION_CHUNK_WINDOW_MINUTES=20

# 环境稳态阈值（分钟），默认 15 分钟
ENV_STABILITY_THRESHOLD_MINUTES=15

# ==================== 应用配置 ====================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 调试模式（仅开发环境使用）
DEBUG=false

# ==================== 限流配置 ====================
# 是否启用限流
RATE_LIMIT_ENABLED=true

# 每分钟请求限制
RATE_LIMIT_PER_MINUTE=100

# ==================== 日志配置 ====================
# 是否在日志中记录敏感数据（仅开发环境）
LOG_SENSITIVE_DATA=false
